# mkfile.sub -- submit job to run prepare simplified tuples

executable = splitbin.sh
arguments = $(Era) $(Process)

log = ./condor_logs/splitbin_$(Era).log

JobBatchName = splitbin_JetHT_$(Era)

request_cpus = 4
request_memory = 8G
request_disk = 10M

max_retries = 1 

should_transfer_files = NO

queue 10 
