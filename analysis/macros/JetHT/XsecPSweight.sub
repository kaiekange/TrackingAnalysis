# mkfile.sub -- submit job to run prepare simplified tuples

executable = XsecPSweight.sh
arguments = $(ERA) $(Process)

log = ./condor_logs/XsecPSweight_$(ERA).log

JobBatchName = IPres_XsecPSweight_JetHT_$(ERA)

request_cpus = 4
request_memory = 8G
request_disk = 10M

max_retries = 1 

should_transfer_files = NO

queue 13 
