# ip_res_analysis.sub -- submit job to run prepare simplified tuples

executable = ip_res.sh
arguments = $(iera) $(Process)

log = ./condor_logs/ip_res_$(Era).log

JobBatchName = IPres_ipres_JetHT_$(Era)

request_cpus = 4
request_memory = 8G
request_disk = 10M

max_retries = 1

should_transfer_files = NO

queue 100
