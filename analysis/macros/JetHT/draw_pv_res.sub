# mkfile.sub -- submit job to run prepare simplified tuples

executable = draw_pv_res.sh
arguments = $(Era) $(Process)

log = ./condor_logs/draw_pv_res_$(Era).log

JobBatchName = draw_pv_res_JetHT_$(Era)

request_cpus = 4
request_memory = 8G
request_disk = 10M

max_retries = 1 

should_transfer_files = NO

queue 10 
