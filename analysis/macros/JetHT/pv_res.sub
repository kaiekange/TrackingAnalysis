# pv_res_analysis.sub -- submit job to run prepare simplified tuples

executable = pv_res.sh
arguments = $(iera) $(trigHT) $(Process)

log = ./condor_logs/pv_res_$(Era)_$(trigHT).log

JobBatchName = IPres_pvres_JetHT_$(Era)_$(trigHT)

request_cpus = 4
request_memory = 8G
request_disk = 10M

max_retries = 1

should_transfer_files = NO

queue 50 
