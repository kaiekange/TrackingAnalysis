# mkfile.sub -- submit job to run prepare simplified tuples

executable = mkfile.sh
arguments = $(Era) $(Process)

log = ./condor_logs/mkfile_$(JobName).log

JobBatchName = IPres_mkfile_ZeroBias_$(JobName)

request_cpus = 4
request_memory = 8G
request_disk = 10M

max_retries = 1 

should_transfer_files = NO

queue $(NumJobs) 
